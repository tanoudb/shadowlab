# Environnement de la course de 7 jours (I9) : lu par scripts/course.sh, format CLE=valeur, aucun secret.
# Isole la course du dossier principal : autres ports, autre projet Docker, autres sorties et identités.
# Les chemins relatifs sont rendus absolus par le script, à partir du dossier de la course.
SHADOWLAB_PORT=8760
SHADOWLAB_PORT_ARENA=8753
SHADOWLAB_PORT_AVAL=8761
SHADOWLAB_ARENA_PROJET=shadowlab-course-i9
SHADOWLAB_SORTIES=outputs
SHADOWLAB_IDENTITES=outputs/identites
# Vitrine de 300 annonces : la première passe finit vers la mi-course (calcul dans identite-7-jours.yaml).
SHADOWLAB_VITRINE_TAILLE=300
