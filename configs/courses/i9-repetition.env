# Répétition de la course I9 : lu APRÈS i9.env quand COURSE_ENV=configs/courses/i9-repetition.env (la dernière valeur
# gagne). Porte courte (profil endurancecourt, 600 s) et vitrine de 30 annonces. Jamais pour la vraie course.
SHADOWLAB_PROFILS_EXTRA=configs/arena/profils-endurance-court.yaml
SHADOWLAB_VITRINE_TAILLE=30
